<Project>

  <PropertyGroup>
    <!-- Intermediates stay out of the test mod folder. The test mod is never published, but a stray
         obj/ under it would still be copied into the WSL game by the staging script, which mirrors
         the folder as it is. .build/ is ignored by this repository. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\.build\pickle\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\..\.build\pickle\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
